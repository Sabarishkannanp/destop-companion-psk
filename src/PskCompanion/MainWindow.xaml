<Window x:Class="PskCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSK Companion · Work &amp; Focus Partner"
        Width="1180" Height="790" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource Ink}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <!-- Header -->
      <RowDefinition Height="Auto" />
      <!-- Content Body -->
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== HEADER ==================== -->
    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✨" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="PSK COMPANION" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="HeaderGreetingText" Text="Good morning, PSK! Time to work! ☀️" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" />
              <Border Background="{StaticResource EmeraldBg}" BorderBrush="{StaticResource EmeraldBorder}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{StaticResource Emerald}" Margin="0,0,4,0" VerticalAlignment="Center" />
                  <TextBlock Text="Active Companion" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Emerald}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="HeaderSubtitleText" Text="Your personal 3D avatar assistant keeping you motivated and focused" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Header Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="🗣️ Morning Greeting" Click="GreetMorning_Click" Padding="12,7" FontSize="12" Margin="0,0,8,0" />
          <Button Content="🚀 Tell Me to Work!" Style="{StaticResource AccentButton}" Click="TellToWork_Click" Padding="14,7" FontSize="12" Margin="0,0,8,0" />
          <Button x:Name="FloatDesktopBtn" Content="📌 Float on Desktop" Click="FloatDesktop_Click" Padding="12,7" FontSize="12" Margin="0,0,8,0" ToolTip="Detach companion to float on your desktop" />
          <CheckBox x:Name="VoiceToggleCheckBox" Content="Voice (TTS)" IsChecked="True" Click="VoiceToggle_Click" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== BODY ==================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- Left: Companion Stage & Customizer -->
        <ColumnDefinition Width="510" />
        <!-- Right: Task Management & Daily Hub -->
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ==================== LEFT COLUMN ==================== -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel>
          <!-- Companion Interactive Stage -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16">
            <StackPanel>
              <!-- Speech Bubble -->
              <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="COMPANION SAYS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                    <Button Content="🔊 Speak" Click="RepeatSpeech_Click" HorizontalAlignment="Right" Padding="6,2" FontSize="10" Margin="0" />
                  </Grid>
                  <TextBlock x:Name="SpeechBubbleText" Text="Good morning, PSK! ☀️ Time to work! Let's get things done and conquer your tasks today." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10" />
                  <!-- Quick Interactive Responses -->
                  <WrapPanel>
                    <Button Content="🚀 Ready to Work!" Style="{StaticResource AccentButton}" Click="TellToWork_Click" Padding="8,4" FontSize="11" Margin="0,0,4,4" />
                    <Button Content="💧 Drink Water" Click="DrinkWater_Click" Padding="8,4" FontSize="11" Margin="0,0,4,4" />
                    <Button Content="🧘 5-Min Stretch" Click="Stretch_Click" Padding="8,4" FontSize="11" Margin="0,0,4,4" />
                    <Button Content="💬 Motivate Me!" Click="MotivateMe_Click" Padding="8,4" FontSize="11" Margin="0,0,4,4" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Avatar Display Pedestal -->
              <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Height="280" Margin="0,0,0,14">
                <Grid x:Name="AvatarContainer" ClipToBounds="True">
                  <!-- Flight / Sky Background Glow (for airplane mode) -->
                  <Canvas x:Name="SkyCanvas" Visibility="Collapsed">
                    <TextBlock Text="☁️" FontSize="26" Opacity="0.4" Canvas.Left="20" Canvas.Top="30" />
                    <TextBlock Text="☁️" FontSize="34" Opacity="0.3" Canvas.Left="380" Canvas.Top="60" />
                    <TextBlock Text="☁️" FontSize="20" Opacity="0.5" Canvas.Left="140" Canvas.Top="140" />
                    <TextBlock Text="💨" FontSize="24" Opacity="0.6" Canvas.Left="60" Canvas.Top="200" />
                  </Canvas>

                  <!-- Ground Spotlight -->
                  <Ellipse x:Name="AvatarShadow" Width="170" Height="22" Fill="#50000000" VerticalAlignment="Bottom" Margin="0,0,0,14" />

                  <!-- Airplane Propeller Wings (Visible in Airplane Mode) -->
                  <Grid x:Name="AirplaneWingsGrid" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="340" Height="38" Background="#3038BDF8" BorderBrush="{StaticResource CyanBorder}" BorderThickness="1" CornerRadius="19" Opacity="0.8" Margin="0,50,0,0" />
                    <TextBlock Text="✈️" FontSize="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0" />
                    <TextBlock Text="✈️" FontSize="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-20,-20,0,0" />
                  </Grid>

                  <!-- Main Avatar Host with Animation Transforms -->
                  <Grid x:Name="AvatarHost" Width="200" Height="240" VerticalAlignment="Bottom" Margin="0,0,0,16" RenderTransformOrigin="0.5,0.8">
                    <Grid.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform x:Name="AvatarScale" />
                        <RotateTransform x:Name="AvatarTilt" />
                        <TranslateTransform x:Name="AvatarBob" />
                      </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Real Photo Avatar Mode -->
                    <Border x:Name="PhotoAvatarBorder" CornerRadius="16" BorderBrush="{StaticResource Accent}" BorderThickness="3" Background="#111B2E" ClipToBounds="True" Visibility="Visible">
                      <Image x:Name="PhotoAvatarImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Pixar Sprite Avatar Mode -->
                    <Image x:Name="PixarAvatarImage" Stretch="Uniform" VerticalAlignment="Bottom" Visibility="Collapsed" />

                    <!-- Accessories Overlay (Aviator Goggles, Wings, Hat, Coffee, Laptop) -->
                    <TextBlock x:Name="GogglesAccessory" Text="🕶️" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="HatAccessory" Text="🎩" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="WingsAccessory" Text="🪽" FontSize="46" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-20,20,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="CoffeeAccessory" Text="☕" FontSize="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,30" Visibility="Collapsed" />
                    <TextBlock x:Name="LaptopAccessory" Text="💻" FontSize="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,10" Visibility="Collapsed" />
                  </Grid>

                  <!-- Mode Badge Overlay -->
                  <Border x:Name="ActiveModeBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,12,0,0">
                    <TextBlock x:Name="ActiveModeBadgeText" Text="👤 My Real Photo" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                  </Border>
                </Grid>
              </Border>

              <!-- Avatar Quick Poses / Actions -->
              <WrapPanel HorizontalAlignment="Center">
                <Button Content="📷 My Photo" Click="SetAvatarMode_Click" Tag="Photo" Padding="10,5" Margin="2" />
                <Button Content="🎨 3D Pixar" Click="SetAvatarMode_Click" Tag="Pixar" Padding="10,5" Margin="2" />
                <Button Content="✈️ Airplane Pilot" Click="SetAvatarMode_Click" Tag="Airplane" Padding="10,5" Margin="2" />
                <Button Content="🚀 Jetpack" Click="SetAvatarMode_Click" Tag="Jetpack" Padding="10,5" Margin="2" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Avatar Customization Controls -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18">
            <StackPanel>
              <TextBlock Text="Customize Avatar &amp; Airplane Mode" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

              <!-- Vehicle / Movement Mode -->
              <TextBlock Text="Vehicle &amp; Movement Style:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,6" />
              <WrapPanel Margin="0,0,0,12">
                <Button x:Name="VehicleAirplaneBtn" Content="✈️ Airplane Flying" Click="SetVehicleMode_Click" Tag="Airplane" Padding="10,5" Margin="0,0,6,4" />
                <Button x:Name="VehicleWalkingBtn" Content="🚶 Walking / Bob" Click="SetVehicleMode_Click" Tag="Walking" Padding="10,5" Margin="0,0,6,4" />
                <Button x:Name="VehicleHoverBtn" Content="🧘 Hovering" Click="SetVehicleMode_Click" Tag="Hover" Padding="10,5" Margin="0,0,6,4" />
                <Button x:Name="VehicleDeskBtn" Content="☕ Desk Buddy" Click="SetVehicleMode_Click" Tag="Desk" Padding="10,5" Margin="0,0,0,4" />
              </WrapPanel>

              <!-- Accessories Selector -->
              <TextBlock Text="Companion Accessory:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,6" />
              <WrapPanel Margin="0,0,0,14">
                <Button Content="🕶️ Aviator Goggles" Click="SetAccessory_Click" Tag="AviatorGoggles" Padding="8,4" Margin="0,0,4,4" />
                <Button Content="✈️ Flight Wings" Click="SetAccessory_Click" Tag="Wings" Padding="8,4" Margin="0,0,4,4" />
                <Button Content="🎩 Top Hat" Click="SetAccessory_Click" Tag="TopHat" Padding="8,4" Margin="0,0,4,4" />
                <Button Content="☕ Coffee" Click="SetAccessory_Click" Tag="CoffeeMug" Padding="8,4" Margin="0,0,4,4" />
                <Button Content="💻 Laptop" Click="SetAccessory_Click" Tag="Laptop" Padding="8,4" Margin="0,0,4,4" />
                <Button Content="⭐ None" Click="SetAccessory_Click" Tag="None" Padding="8,4" Margin="0,0,0,4" />
              </WrapPanel>

              <!-- Avatar Size Slider -->
              <Grid Margin="0,0,0,4">
                <TextBlock Text="Avatar Scale" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Left" />
                <TextBlock x:Name="AvatarScaleLabel" Text="200 DIP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
              </Grid>
              <Slider x:Name="AvatarSizeSlider" Minimum="150" Maximum="260" Value="{Binding AvatarHeight}" ValueChanged="AvatarSizeSlider_ValueChanged" Margin="0,0,0,14" />

              <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
 <StackPanel>
  <TextBlock Text="When should PSK appear?" FontSize="16" FontWeight="Bold" />
  <TextBlock Text="Local time. Use yyyy-MM-dd HH:mm for dates. Equal hours mean all day." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,10" />
  <TextBlock Text="Your name" /><TextBox x:Name="ProfileNameBox" Text="{Binding UserName}" Margin="0,4,0,8" />
  <CheckBox x:Name="AutomaticRemindersCheck" Content="Enable automatic task reminders" IsChecked="{Binding RemindersEnabled}" Margin="0,0,0,8" />
  <CheckBox x:Name="AutoShowCheck" Content="Show avatar when the app starts" IsChecked="{Binding AutoShowCompanion}" Margin="0,0,0,10" />
  <TextBlock Text="Repeat interval (minutes)" /><TextBox x:Name="IntervalMinutesBox" Text="{Binding WorkReminderMinutes, ValidatesOnExceptions=True}" Margin="0,4,0,8" />
  <TextBlock Text="Active from / until (HH:mm)" />
  <UniformGrid Columns="2"><TextBox x:Name="ActiveFromBox" Text="{Binding ReminderStart, StringFormat={}{0:hh\\:mm}, ValidatesOnExceptions=True}" Margin="0,4,6,8" /><TextBox x:Name="ActiveUntilBox" Text="{Binding ReminderEnd, StringFormat={}{0:hh\\:mm}, ValidatesOnExceptions=True}" Margin="0,4,0,8" /></UniformGrid>
  <TextBlock Text="Next repeat appearance" /><TextBox x:Name="NextAppearanceBox" Text="{Binding NextAppearance, StringFormat={}{0:yyyy-MM-dd HH:mm}, ValidatesOnExceptions=True}" Margin="0,4,0,8" />
  <TextBlock Text="Character stays until you choose Done or Remind me later." TextWrapping="Wrap" Margin="0,4,0,8" />
  <Button Content="Save timing and name" Click="SaveTiming_Click" Style="{StaticResource AccentButton}" />
  <TextBlock x:Name="TimingStatus" Text="Set task-specific times in the task table." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,8,0,0" />
 </StackPanel>
</Border><!-- Upload Custom Photo -->
              <Button Content="📁 Choose Any Photo from Computer..." Click="UploadCustomPhoto_Click" HorizontalAlignment="Stretch" Padding="12,7" Margin="0,0,0,6" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ==================== RIGHT COLUMN: TASKS & PRODUCTIVITY ==================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <!-- Tasks Manager -->
          <RowDefinition Height="*" />
          <!-- Wellness & Work Stats -->
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tasks Manager -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
          <DockPanel>
            <!-- Add Task Bar -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
              <TextBlock Text="My Tasks · What to Work on Today" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Task Title Input -->
                <TextBox x:Name="TaskInputBox" Margin="0,0,8,0" VerticalAlignment="Center" KeyDown="TaskInputBox_KeyDown" />

                <!-- Category -->
                <ComboBox x:Name="TaskCategoryCombo" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                  <ComboBoxItem Content="Work 💼" IsSelected="True" />
                  <ComboBoxItem Content="Coding 💻" />
                  <ComboBoxItem Content="Design 🎨" />
                  <ComboBoxItem Content="Health 💧" />
                  <ComboBoxItem Content="Personal ⭐" />
                </ComboBox>

                <!-- Priority -->
                <ComboBox x:Name="TaskPriorityCombo" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                  <ComboBoxItem Content="High 🔥" IsSelected="True" />
                  <ComboBoxItem Content="Medium ⚡" />
                  <ComboBoxItem Content="Low ☕" />
                </ComboBox>

                <!-- Add Button -->
                <Button Grid.Column="3" Content="+ Add Task" Style="{StaticResource AccentButton}" Click="AddTask_Click" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>

            <!-- Tasks Header / Stats summary -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="TaskCountSummaryText" Text="3 tasks pending today" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Content="Clear Completed" Click="ClearCompletedTasks_Click" HorizontalAlignment="Right" Padding="8,4" FontSize="11" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
 <TextBlock Text="Task appearance times (leave blank for no timed reminder)" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedText}" />
 <DataGrid x:Name="TaskTimingGrid" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="125" Margin="0,6,0,4">
  <DataGrid.Columns><DataGridTextColumn Header="Task" Binding="{Binding Title}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="Appear at: yyyy-MM-dd HH:mm" Binding="{Binding RemindAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, ValidatesOnExceptions=True}" Width="190" /></DataGrid.Columns>
 </DataGrid>
 <Button Content="Save task times" Click="SaveTaskTimes_Click" HorizontalAlignment="Left" Padding="10,5" />
</StackPanel><!-- Tasks Scrollable List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TasksItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Completion CheckBox -->
                        <CheckBox IsChecked="{Binding IsCompleted}" Click="TaskToggle_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Category Badge -->
                        <Border Grid.Column="2" Background="{StaticResource CyanBg}" BorderBrush="{StaticResource CyanBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" />
                        </Border>

                        <!-- Priority Badge -->
                        <Border Grid.Column="3" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Priority}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>

                        <!-- Tell Me to Work Button -->
                        <Button Grid.Column="4" Content="🎯 Tell Me to Work" Click="TellToWorkTask_Click" Tag="{Binding Id}" Padding="8,4" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Companion will highlight this task and speak aloud" />

                        <!-- Delete Button -->
                        <Button Grid.Column="5" Content="✕" Style="{StaticResource DangerButton}" Click="DeleteTask_Click" Tag="{Binding Id}" Padding="8,4" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Wellness & Hydration Panel -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hydration Progress -->
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="💧 DAILY HYDRATION GOAL: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                <TextBlock x:Name="WaterCountLabel" Text="2 / 8 Glasses" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}" />
              </StackPanel>
              <ProgressBar x:Name="WaterProgressBar" Height="8" Value="2" Maximum="8" Foreground="{StaticResource Cyan}" Background="{StaticResource InputBackground}" BorderThickness="0" Width="380" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <TextBlock Text="Staying hydrated boosts focus and cognitive power during work." FontSize="11" Foreground="{StaticResource MutedText}" />
            </StackPanel>

            <!-- Quick Water Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="+1 Glass 💧" Style="{StaticResource AccentButton}" Click="AddGlass_Click" Padding="14,8" FontSize="12" Margin="0,0,6,0" />
              <Button Content="- Undo" Click="UndoGlass_Click" Padding="10,8" FontSize="12" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>

