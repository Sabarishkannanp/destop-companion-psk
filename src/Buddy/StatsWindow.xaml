<Window x:Class="Buddy.StatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PSK Buddy · Your week" Width="570" Height="470" ResizeMode="NoResize" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}">
  <StackPanel Margin="30"><TextBlock Text="A little better, every day" FontSize="26" FontWeight="Bold" /><TextBlock Text="YOUR WATER MOMENTS" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,16,0,4" /><TextBlock x:Name="TodayText" FontSize="44" FontWeight="Bold" Foreground="#D89B10" /><Border CornerRadius="20" Background="{StaticResource PanelBackground}" Padding="20" Margin="0,18,0,0"><StackPanel><TextBlock Text="Last 7 days" FontSize="16" FontWeight="SemiBold" /><UniformGrid x:Name="Chart" Columns="7" Height="165" Margin="0,12,0,0" /></StackPanel></Border><TextBlock Text="Counts reflect the water reminders you confirmed." Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,0" /></StackPanel>
</Window>
