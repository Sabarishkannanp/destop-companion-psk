<Window x:Class="Buddy.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSK Charm · Companion Dashboard"
        Width="1080" Height="740" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource Ink}">

  <Grid Background="{StaticResource WindowBackground}">
    <Grid.ColumnDefinitions>
      <!-- Sidebar Navigation -->
      <ColumnDefinition Width="240" />
      <!-- Main Content Area -->
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ==================== SIDEBAR ==================== -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
      <Grid Margin="16,20,16,16">
        <Grid.RowDefinitions>
          <!-- Logo & Brand Header -->
          <RowDefinition Height="Auto" />
          <!-- Nav Buttons -->
          <RowDefinition Height="*" />
          <!-- Bottom Status Card -->
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,24">
          <Border HorizontalAlignment="Left" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="PSK CHARM" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="Companion Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
          <TextBlock Text="Personal productivity &amp; wellness" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Navigation Tabs -->
        <StackPanel Grid.Row="1">
          <Button x:Name="NavOverviewBtn" Click="NavOverview_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🏠" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="Overview" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="NavCompanionBtn" Click="NavCompanion_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🤖" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="My Companion" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="NavTasksBtn" Click="NavTasks_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <Grid Width="170">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="📋" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="My Tasks" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border x:Name="TaskCountBadge" HorizontalAlignment="Right" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                <TextBlock x:Name="TaskBadgeText" Text="3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
              </Border>
            </Grid>
          </Button>

          <Button x:Name="NavRemindersBtn" Click="NavReminders_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <Grid Width="170">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="⏰" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="Reminders" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border HorizontalAlignment="Right" Background="{StaticResource CyanBg}" BorderBrush="{StaticResource CyanBorder}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                <TextBlock x:Name="ReminderBadgeText" Text="3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
              </Border>
            </Grid>
          </Button>

          <Button x:Name="NavStatsBtn" Click="NavStats_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="Hydration &amp; Stats" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="NavSettingsBtn" Click="NavSettings_Click" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙️" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
              <TextBlock Text="Settings &amp; System" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Companion Live Status Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="12">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Emerald}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Companion Active" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Emerald}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="SidebarAvatarName" Text="PSK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="Always ready to guide your day." FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,10" />
            <Button Content="🚶 Summon to Screen" Style="{StaticResource AccentButton}" Padding="10,6" FontSize="11" Click="SummonCompanion_Click" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <Grid Grid.Column="1" Margin="24,20,24,20">
      <Grid.RowDefinitions>
        <!-- Top Action Bar -->
        <RowDefinition Height="Auto" />
        <!-- Content Body -->
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Top Action Bar -->
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <StackPanel HorizontalAlignment="Left">
          <TextBlock x:Name="SectionTitle" Text="Dashboard Overview" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
          <TextBlock x:Name="SectionSubtitle" Text="Live companion metrics, focus tasks, and daily hydration" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="💧 +1 Glass" Click="QuickAddGlass_Click" Padding="12,7" FontSize="12" Margin="0,0,8,0" />
          <Button Content="💬 Fun Remark" Click="SayFunLine_Click" Padding="12,7" FontSize="12" Margin="0,0,8,0" />
          <Button Content="📁 Avatar Folder" Click="OpenAvatarFolder_Click" Padding="12,7" FontSize="12" />
        </StackPanel>
      </Grid>

      <!-- TAB 1: OVERVIEW -->
      <ScrollViewer x:Name="TabOverview" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Hero Greeting Banner -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="GreetingText" Text="Good day, PSK! ✨" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="Your 3D companion is active on the taskbar. Keep hydrated and achieve your goals today." FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Status: " FontSize="12" Foreground="{StaticResource MutedText}" />
                  <TextBlock Text="Ready &amp; Hydrated 💧" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- 4 Stat Metric Cards -->
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Hydration -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="💧 HYDRATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6" />
                <TextBlock x:Name="MetricWaterText" Text="0 / 8 Glasses" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <ProgressBar x:Name="MetricWaterBar" Height="6" Value="0" Maximum="8" Margin="0,8,0,8" Foreground="{StaticResource Cyan}" Background="{StaticResource InputBackground}" BorderThickness="0" />
                <Button Content="+ Drink Water" Click="QuickAddGlass_Click" HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0" />
              </StackPanel>
            </Border>

            <!-- Card 2: Tasks -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="📋 ACTIVE TASKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                <TextBlock x:Name="MetricTasksText" Text="3 Pending" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="MetricTasksSubtext" Text="0 completed today" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,8,0,8" />
                <Button Content="+ Manage Tasks" Click="NavTasks_Click" HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0" />
              </StackPanel>
            </Border>

            <!-- Card 3: Reminders -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="⏰ REMINDERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Emerald}" Margin="0,0,0,6" />
                <TextBlock x:Name="MetricRemindersText" Text="3 Active" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock Text="Water, Stretch &amp; Eyes" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,8,0,8" />
                <Button Content="Test Water Now" Click="TestWaterReminder_Click" HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0" />
              </StackPanel>
            </Border>

            <!-- Card 4: Companion Mood -->
            <Border Grid.Column="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
              <StackPanel>
                <TextBlock Text="🤖 COMPANION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Purple}" Margin="0,0,0,6" />
                <TextBlock x:Name="MetricMoodText" Text="Energetic ⚡" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="MetricSpeedSizeText" Text="220 DIP · 120 px/s" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,8,0,8" />
                <Button Content="Tune Avatar" Click="NavCompanion_Click" HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Split Showcase Section -->
          <Grid>
            <Grid.ColumnDefinitions>
              <!-- Left: Avatar Interactive Card -->
              <ColumnDefinition Width="340" />
              <!-- Right: Focus Task List -->
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Avatar Showcase -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,18,0">
              <StackPanel>
                <TextBlock Text="Live Avatar Showcase" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Height="220" Margin="0,0,0,14">
                  <Grid>
                    <!-- Shadow -->
                    <Ellipse Width="110" Height="16" Fill="#40000000" VerticalAlignment="Bottom" Margin="0,0,0,14" />
                    <!-- Sprite Image -->
                    <Image x:Name="OverviewAvatarImage" Stretch="Uniform" Height="190" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                  <Button Content="Front" Click="PoseSelect_Click" Tag="idle_front.png" Padding="8,4" FontSize="11" />
                  <Button Content="Walk" Click="PoseSelect_Click" Tag="walk_right_1.png" Padding="8,4" FontSize="11" />
                  <Button Content="Drink" Click="PoseSelect_Click" Tag="drink_water.png" Padding="8,4" FontSize="11" />
                  <Button Content="Wave" Click="PoseSelect_Click" Tag="wave.png" Padding="8,4" FontSize="11" />
                  <Button Content="Sad" Click="PoseSelect_Click" Tag="sad.png" Padding="8,4" FontSize="11" />
                </StackPanel>
                <Button Content="🚶 Summon Companion to Desktop" Style="{StaticResource AccentButton}" Click="SummonCompanion_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                <Button Content="🏃 Send Offscreen" Click="DismissCompanion_Click" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>

            <!-- Right: Today's Focus Tasks & Upcoming -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <TextBlock Text="Today's Priority Tasks" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Left" />
                  <Button Content="+ Add Task" Click="NavTasks_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                </Grid>

                <ItemsControl x:Name="OverviewTaskItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsCompleted}" Click="OverviewTaskToggle_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="2" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="OverviewNoTasksText" Text="No active tasks. Add tasks to keep your momentum going!" FontSize="12" Foreground="{StaticResource MutedText}" FontStyle="Italic" Visibility="Collapsed" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- TAB 2: MY COMPANION (EDIT COMPANION) -->
      <ScrollViewer x:Name="TabCompanion" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <!-- Settings & Configuration -->
            <ColumnDefinition Width="*" />
            <!-- Live Avatar Studio -->
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <!-- Left Column: Settings Form -->
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <!-- Card 1: Identity & Persona -->
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Companion Identity &amp; Persona" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />

                <TextBlock Text="Companion Name" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
                <TextBox x:Name="CompanionNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Persona Title / Tagline" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
                <TextBox x:Name="CompanionPersonaBox" Text="{Binding PersonaTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Companion Mood / Attitude" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
                <ComboBox x:Name="CompanionMoodCombo" Margin="0,0,0,4">
                  <ComboBoxItem Content="Energetic ⚡" />
                  <ComboBoxItem Content="Calm &amp; Mindful 🧘" />
                  <ComboBoxItem Content="Hydration Coach 💧" />
                  <ComboBoxItem Content="Playful &amp; Cheerful 🎉" />
                  <ComboBoxItem Content="Laser Focused 🎯" />
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- Card 2: Visual & Animation Dynamics -->
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Movement &amp; Dynamics" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />

                <!-- Height Slider -->
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="Avatar Height" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left" />
                  <TextBlock x:Name="AvatarHeightLabel" Text="220 DIP" FontSize="12" Foreground="{StaticResource Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="AvatarHeightSlider" Minimum="140" Maximum="260" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding AvatarSize}" ValueChanged="AvatarHeightSlider_ValueChanged" Margin="0,0,0,16" />

                <!-- Speed Slider -->
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="Walking Speed" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left" />
                  <TextBlock x:Name="WalkSpeedLabel" Text="120 DIP/s" FontSize="12" Foreground="{StaticResource Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="WalkSpeedSlider" Minimum="40" Maximum="240" Value="{Binding WalkSpeed}" ValueChanged="WalkSpeedSlider_ValueChanged" Margin="0,0,0,16" />

                <TextBlock Text="Your character stays until you choose Done / Yes or Remind me later." TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{StaticResource Accent}" />

                <!-- CheckBoxes -->
                <CheckBox Content="Enable subtle breathing animation during idle" IsChecked="{Binding BreathingEnabled}" Margin="0,0,0,10" />
                <CheckBox Content="Enable natural step bounce (sine bob)" IsChecked="{Binding BobEnabled}" Margin="0,0,0,10" />
                <CheckBox Content="Play gentle chime pop sound when companion enters" IsChecked="{Binding SoundEnabled}" />
              </StackPanel>
            </Border>

            <!-- Save Changes Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
              <Button Content="Save Companion Profile" Style="{StaticResource AccentButton}" Click="SaveCompanionSettings_Click" Padding="20,10" />
            </StackPanel>
          </StackPanel>

          <!-- Right Column: Interactive Sprite Studio -->
          <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="Interactive Avatar Studio" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />

              <!-- Display Card -->
              <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Height="280" Margin="0,0,0,16">
                <Grid>
                  <!-- Background Glow Circle -->
                  <Ellipse Width="180" Height="180" Fill="#10FFC837" />
                  <Ellipse Width="140" Height="20" Fill="#50000000" VerticalAlignment="Bottom" Margin="0,0,0,16" />
                  <!-- Avatar Image -->
                  <Image x:Name="StudioAvatarImage" Stretch="Uniform" Height="240" VerticalAlignment="Bottom" Margin="0,0,0,16" />
                </Grid>
              </Border>

              <TextBlock Text="Preview Pose:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" />
              <!-- Pose Grid -->
              <WrapPanel Margin="0,0,0,16">
                <Button Content="Idle Front" Click="StudioPose_Click" Tag="idle_front.png" Padding="10,5" Margin="2" />
                <Button Content="Drink Water 💧" Click="StudioPose_Click" Tag="drink_water.png" Padding="10,5" Margin="2" />
                <Button Content="Wave 👋" Click="StudioPose_Click" Tag="wave.png" Padding="10,5" Margin="2" />
                <Button Content="Sad / Snooze 🥺" Click="StudioPose_Click" Tag="sad.png" Padding="10,5" Margin="2" />
                <Button Content="Walk 1" Click="StudioPose_Click" Tag="walk_right_1.png" Padding="8,5" Margin="2" />
                <Button Content="Walk 2" Click="StudioPose_Click" Tag="walk_right_2.png" Padding="8,5" Margin="2" />
                <Button Content="Walk 3" Click="StudioPose_Click" Tag="walk_right_3.png" Padding="8,5" Margin="2" />
                <Button Content="Walk 4" Click="StudioPose_Click" Tag="walk_right_4.png" Padding="8,5" Margin="2" />
              </WrapPanel>

              <TextBlock Text="Desktop Actions:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" />
              <Button Content="🚶 Test Walk Onto Desktop" Style="{StaticResource AccentButton}" Click="SummonCompanion_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
              <Button Content="🏃 Send Offscreen" Click="DismissCompanion_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
              <Button Content="💬 Test Speech Bubble" Click="SayFunLine_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
              <Button Content="📁 Open Avatar Sprites Folder" Click="OpenAvatarFolder_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- TAB 3: MY TASKS (ADD & MANAGE TASKS) -->
      <Grid x:Name="TabTasks" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <!-- Add Task Card -->
          <RowDefinition Height="Auto" />
          <!-- Filter & Controls -->
          <RowDefinition Height="Auto" />
          <!-- Tasks List -->
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Add Task Card -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Add New Task / Goal" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Task Title -->
              <TextBox x:Name="NewTaskTitleBox" Margin="0,0,10,0" VerticalAlignment="Center" KeyDown="NewTaskTitleBox_KeyDown" />

              <!-- Category -->
              <ComboBox x:Name="NewTaskCategoryCombo" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                <ComboBoxItem Content="Coding 💻" IsSelected="True" />
                <ComboBoxItem Content="Health 💧" />
                <ComboBoxItem Content="Work 💼" />
                <ComboBoxItem Content="Personal ⭐" />
              </ComboBox>

              <!-- Priority -->
              <ComboBox x:Name="NewTaskPriorityCombo" Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <ComboBoxItem Content="High 🔥" />
                <ComboBoxItem Content="Medium ⚡" IsSelected="True" />
                <ComboBoxItem Content="Low ☕" />
              </ComboBox>

              <!-- Add Button -->
              <Button Grid.Column="3" Content="+ Add Task" Style="{StaticResource AccentButton}" Click="AddTask_Click" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Margin="0,12,0,0">
              <CheckBox x:Name="ScheduleNewTask" Content="Show character at" VerticalAlignment="Center" Margin="0,0,12,0" />
              <DatePicker x:Name="NewTaskDate" Width="145" Margin="0,0,10,0" />
              <TextBox x:Name="NewTaskTime" Width="75" ToolTip="24-hour time: HH:mm" />
              <TextBlock Text="HH:mm (local time)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedText}" />
            </WrapPanel>
            <TextBlock x:Name="TaskEntryStatus" Text="Add a task and optionally choose when the character should appear." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedText}" />
          </StackPanel>
        </Border>

        <!-- Filter Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="TaskFilterAllBtn" Content="All Tasks" Click="TaskFilter_Click" Tag="All" Padding="12,5" FontSize="12" Margin="0,0,6,0" />
            <Button x:Name="TaskFilterActiveBtn" Content="Active" Click="TaskFilter_Click" Tag="Active" Padding="12,5" FontSize="12" Margin="0,0,6,0" />
            <Button x:Name="TaskFilterCompletedBtn" Content="Completed" Click="TaskFilter_Click" Tag="Completed" Padding="12,5" FontSize="12" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear Completed" Click="ClearCompletedTasks_Click" Padding="12,5" FontSize="12" />
          </StackPanel>
        </Grid>

        <!-- Tasks Items List -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl x:Name="TasksListItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- CheckBox -->
                        <CheckBox IsChecked="{Binding IsCompleted}" Click="TaskItemToggle_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Category Pill -->
                        <Border Grid.Column="2" Background="{StaticResource CyanBg}" BorderBrush="{StaticResource CyanBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" />
                        </Border>

                        <!-- Priority Pill -->
                        <Border Grid.Column="3" Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="🎯 Remind Me" Click="RemindTaskWithBuddy_Click" Tag="{Binding Id}" Padding="8,4" FontSize="11" Margin="0,0,4,0" ToolTip="Ask Buddy to remind you of this task on screen" />
                          <Button Content="✕" Style="{StaticResource DangerButton}" Click="DeleteTask_Click" Tag="{Binding Id}" Padding="8,4" FontSize="11" ToolTip="Delete Task" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="NoTasksFilteredNotice" Text="No tasks found for the current filter." FontSize="13" Foreground="{StaticResource MutedText}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- TAB 4: REMINDERS (UPDATE REMINDERS) -->
      <Grid x:Name="TabReminders" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <!-- Existing Reminders List -->
          <RowDefinition Height="*" />
          <!-- Add Reminder Form -->
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Reminders List -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Active Desktop Reminders" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" />
              <TextBlock Text="Your companion automatically strolls across your screen to present these reminders." FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" /> <TextBlock Text="Edit when the avatar appears" FontSize="13" FontWeight="Bold" Margin="0,10,0,5" />
 <TextBlock Text="Dates: yyyy-MM-dd HH:mm. Times: HH:mm:ss. Use {name} in messages." FontSize="11" Foreground="{StaticResource MutedText}" />
 <DataGrid x:Name="ScheduleGrid" ItemsSource="{Binding Reminders}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="125" Margin="0,6,0,6">
  <DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /><DataGridTextColumn Header="Minutes" Binding="{Binding IntervalMinutes, ValidatesOnExceptions=True}" Width="65" /><DataGridTextColumn Header="From" Binding="{Binding StartTime, ValidatesOnExceptions=True}" Width="75" /><DataGridTextColumn Header="Until" Binding="{Binding EndTime, ValidatesOnExceptions=True}" Width="75" /><DataGridTextColumn Header="Next appearance" Binding="{Binding NextDue, StringFormat={}{0:yyyy-MM-dd HH:mm}, ValidatesOnExceptions=True}" Width="155" /></DataGrid.Columns>
 </DataGrid>
 <TextBlock Text="Tell me a task at a specific time (blank = no scheduled appearance)" FontSize="12" FontWeight="SemiBold" />
 <DataGrid x:Name="TaskScheduleGrid" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="105" Margin="0,6,0,6">
  <DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding RemindWithBuddy}" /><DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="*" /><DataGridTextColumn Header="Appear at: yyyy-MM-dd HH:mm" Binding="{Binding RemindAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, ValidatesOnExceptions=True}" Width="210" /></DataGrid.Columns>
 </DataGrid>
 <Button Content="Save appearance times" Click="SaveAppearanceTimes_Click" HorizontalAlignment="Left" />
 <TextBlock x:Name="AppearanceStatus" Text="The character waits for your choice. Due reminders queue while it is on screen." TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="RemindersItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Enabled CheckBox -->
                        <CheckBox IsChecked="{Binding Enabled}" Click="ReminderToggle_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Enable / Disable Reminder" />

                        <!-- Reminder Message & Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Every " FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding IntervalMinutes, StringFormat={}{0} min}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text=" · Active " FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text=" to " FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding EndTime, StringFormat={}{0:hh\\:mm}}" FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text=" · Pose: " FontSize="11" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Pose}" FontSize="11" Foreground="{StaticResource Cyan}" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Kind Badge -->
                        <Border Grid.Column="2" Background="{StaticResource EmeraldBg}" BorderBrush="{StaticResource EmeraldBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Emerald}" />
                        </Border>

                        <!-- Test Button -->
                        <Button Grid.Column="3" Content="▶ Test on Screen" Click="TestSpecificReminder_Click" Tag="{Binding Id}" Padding="10,5" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />

                        <!-- Delete Button -->
                        <Button Grid.Column="4" Content="✕" Style="{StaticResource DangerButton}" Click="DeleteReminder_Click" Tag="{Binding Id}" Padding="8,5" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Add Reminder Section -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="18">
          <StackPanel>
            <TextBlock Text="Create New Reminder" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />

            <!-- Presets Row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="Presets: " FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="💧 Water (45m)" Click="PresetWater_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
              <Button Content="🤸 Stretch (60m)" Click="PresetStretch_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
              <Button Content="👀 Eyes (20m)" Click="PresetEyes_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
              <Button Content="🫁 Deep Breath (30m)" Click="PresetBreath_Click" Padding="8,4" FontSize="11" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Message -->
              <TextBox x:Name="NewReminderMessageBox" Margin="0,0,10,0" VerticalAlignment="Center" />

              <!-- Interval -->
              <TextBox x:Name="NewReminderIntervalBox" Text="45" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" />

              <!-- Pose ComboBox -->
              <ComboBox x:Name="NewReminderPoseCombo" Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <ComboBoxItem Content="drink_water.png" IsSelected="True" />
                <ComboBoxItem Content="wave.png" />
                <ComboBoxItem Content="idle_front.png" />
                <ComboBoxItem Content="sad.png" />
              </ComboBox>

              <!-- Kind ComboBox -->
              <ComboBox x:Name="NewReminderKindCombo" Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                <ComboBoxItem Content="water" IsSelected="True" />
                <ComboBoxItem Content="stretch" />
                <ComboBoxItem Content="eyes" />
                <ComboBoxItem Content="custom" />
              </ComboBox>

              <!-- Add Button -->
              <Button Grid.Column="4" Content="+ Add Reminder" Style="{StaticResource AccentButton}" Click="AddReminder_Click" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- TAB 5: STATS & HYDRATION -->
      <ScrollViewer x:Name="TabStats" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <!-- Hydration Hero Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DAILY HYDRATION PROGRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="StatsGlassesCount" Text="0" FontSize="44" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                  <TextBlock Text=" / 8 Glasses" FontSize="20" Foreground="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                </StackPanel>
                <TextBlock x:Name="StatsGoalPercentageText" Text="0% of daily hydration goal achieved" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,12" />
                <ProgressBar x:Name="StatsProgressBar" Height="10" Value="0" Maximum="8" Foreground="{StaticResource Cyan}" Background="{StaticResource InputBackground}" BorderThickness="0" Width="380" HorizontalAlignment="Left" />
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="💧 + Add Glass" Style="{StaticResource AccentButton}" Click="QuickAddGlass_Click" Padding="18,10" FontSize="14" Margin="0,0,0,8" />
                <Button Content="- Undo Glass" Click="UndoGlass_Click" Padding="14,6" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 7-Day History Chart Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="7-Day Hydration History" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,16" />
              <!-- Chart Container -->
              <Grid x:Name="ChartGrid" Height="200" Margin="0,0,0,10">
                <!-- Dynamically populated bars in code behind -->
              </Grid>
            </StackPanel>
          </Border>

          <!-- Companion Milestones -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="Companion Achievements &amp; Streaks" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="🏆 Hydration Hero" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Drink 8 glasses of water in a single day." FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="🤸 Mobility Master" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Emerald}" />
                    <TextBlock Text="Completed stretch breaks consistently." FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                  <StackPanel>
                    <TextBlock Text="⚡ Productivity Champ" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Purple}" />
                    <TextBlock Text="Crush multiple tasks with your companion." FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- TAB 6: SETTINGS & SYSTEM -->
      <ScrollViewer x:Name="TabSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <!-- System & Startup Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="System &amp; Startup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />
              <CheckBox x:Name="StartupCheckBox" Content="Launch Buddy companion automatically when Windows starts" Click="StartupCheckBox_Click" Margin="0,0,0,12" />
              <CheckBox x:Name="SoundCheckBox" Content="Play gentle chime pop sound when reminders appear" IsChecked="{Binding SoundEnabled}" Margin="0,0,0,12" />
              <Button Content="🔊 Test Reminder Sound" Click="TestSound_Click" HorizontalAlignment="Left" Padding="12,6" FontSize="12" />
            </StackPanel>
          </Border>

          <!-- Pause Companion Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Pause Companion" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
              <TextBlock Text="Need uninterrupted focus or in a meeting? Temporarily pause Buddy." FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Content="Pause 30 Minutes" Click="Pause30Min_Click" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="Pause 1 Hour" Click="Pause1Hour_Click" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="Pause Until Tomorrow" Click="PauseTomorrow_Click" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="Resume Companion" Style="{StaticResource AccentButton}" Click="ResumeCompanion_Click" Padding="12,7" Margin="0,0,8,6" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Directories & Data Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Application Folders &amp; Data" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Content="📁 Open AppData Folder" Click="OpenAppDataFolder_Click" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="🖼️ Open Avatar Sprites" Click="OpenAvatarFolder_Click" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="📄 View Diagnostic Log" Click="OpenDiagLog_Click" Padding="12,7" Margin="0,0,8,6" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- About Card -->
          <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid>
              <StackPanel>
                <TextBlock Text="PSK Charm · Companion Edition 2.0" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Accent}" />
                <TextBlock Text="Crafted exclusively for PSK · 3D Pixar Avatar Companion &amp; Productivity Hub" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" />
                <TextBlock Text=".NET 8 · WPF · Windows 10/11 Per-Monitor DPI Aware" FontSize="11" Foreground="{StaticResource SubtleText}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

