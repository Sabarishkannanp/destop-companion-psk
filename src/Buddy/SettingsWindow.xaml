<Window x:Class="Buddy.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PSK Buddy · Settings" Width="860" Height="700" MinWidth="750" MinHeight="620" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="PSK / Make Buddy yours" FontSize="29" FontWeight="Bold" /><TextBlock Text="Little reminders. A healthier day." Foreground="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="20" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,25,0"><TextBlock Text="Your name" FontWeight="SemiBold" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,14" /><CheckBox Content="Play a gentle reminder sound" IsChecked="{Binding SoundEnabled}" /><Button Content="Open avatar folder" Click="OpenFolder" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Avatar height" FontWeight="SemiBold" /><Slider Minimum="140" Maximum="260" Value="{Binding AvatarSize}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,12,0,3" /><TextBlock Text="{Binding AvatarSize, StringFormat={}{0:0} DIP}" Foreground="{StaticResource MutedText}" /><TextBlock Text="Walking speed" FontWeight="SemiBold" Margin="0,14,0,0" /><Slider Minimum="40" Maximum="240" Value="{Binding WalkSpeed}" Margin="0,12,0,3" /><TextBlock Text="{Binding WalkSpeed, StringFormat={}{0:0} DIP per second}" Foreground="{StaticResource MutedText}" /></StackPanel>
    </Grid></Border>
    <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Your reminders" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Use {name} in messages · Times use HH:mm:ss · Equal times mean all day." FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5,0,12" /></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="+ Add reminder" Click="AddReminder" /><Button Content="Delete selected" Click="DeleteReminder" /></StackPanel>
      <DataGrid x:Name="ReminderGrid" ItemsSource="{Binding Reminders}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" RowHeight="38" Background="{StaticResource PanelBackground}" SelectionMode="Single">
        <DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40" /><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" /><DataGridTextColumn Header="Minutes" Binding="{Binding IntervalMinutes, ValidatesOnExceptions=True}" Width="65" /><DataGridTextColumn Header="From" Binding="{Binding StartTime, ValidatesOnExceptions=True}" Width="75" /><DataGridTextColumn Header="Until" Binding="{Binding EndTime, ValidatesOnExceptions=True}" Width="75" /><DataGridTextColumn Header="Pose" Binding="{Binding Pose}" Width="95" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="65" /></DataGrid.Columns>
      </DataGrid>
    </DockPanel></Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancel" Click="Cancel" /><Button Content="Save changes" Background="#FFD05A" Foreground="#192338" FontWeight="SemiBold" Click="Save" /></StackPanel>
  </Grid>
</Window>
