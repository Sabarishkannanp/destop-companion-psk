<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Core Palette - PSK Charm Modern Dark Theme -->
  <SolidColorBrush x:Key="WindowBackground" Color="#0B111E" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#0D1527" />
  <SolidColorBrush x:Key="PanelBackground" Color="#131E33" />
  <SolidColorBrush x:Key="CardBackground" Color="#17233B" />
  <SolidColorBrush x:Key="CardHoverBackground" Color="#1E2D4A" />
  <SolidColorBrush x:Key="CardBorder" Color="#223554" />
  <SolidColorBrush x:Key="CardBorderHover" Color="#3B537E" />

  <SolidColorBrush x:Key="Ink" Color="#F8FAFC" />
  <SolidColorBrush x:Key="MutedText" Color="#94A3B8" />
  <SolidColorBrush x:Key="SubtleText" Color="#64748B" />

  <!-- Accent Gold / Amber -->
  <SolidColorBrush x:Key="Accent" Color="#FFC837" />
  <SolidColorBrush x:Key="AccentHover" Color="#FFD55E" />
  <SolidColorBrush x:Key="AccentMuted" Color="#33240A" />
  <SolidColorBrush x:Key="AccentBorder" Color="#7A5610" />
  <SolidColorBrush x:Key="AccentInk" Color="#0F172A" />

  <!-- Status / Category Colors -->
  <SolidColorBrush x:Key="Cyan" Color="#38BDF8" />
  <SolidColorBrush x:Key="CyanBg" Color="#0C2538" />
  <SolidColorBrush x:Key="CyanBorder" Color="#0284C7" />

  <SolidColorBrush x:Key="Emerald" Color="#10B981" />
  <SolidColorBrush x:Key="EmeraldBg" Color="#062E20" />
  <SolidColorBrush x:Key="EmeraldBorder" Color="#059669" />

  <SolidColorBrush x:Key="Rose" Color="#F43F5E" />
  <SolidColorBrush x:Key="RoseBg" Color="#38101C" />
  <SolidColorBrush x:Key="RoseBorder" Color="#E11D48" />

  <SolidColorBrush x:Key="Purple" Color="#A855F7" />
  <SolidColorBrush x:Key="PurpleBg" Color="#28113B" />
  <SolidColorBrush x:Key="PurpleBorder" Color="#7E22CE" />

  <!-- Input Field Brushes -->
  <SolidColorBrush x:Key="InputBackground" Color="#0B1322" />
  <SolidColorBrush x:Key="InputBorder" Color="#233554" />
  <SolidColorBrush x:Key="InputBorderFocus" Color="#FFC837" />

  <!-- Base Window Style -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource WindowBackground}" />
  </Style>

  <!-- Default Button Style -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Background" Value="#23324E" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="#2C3D5E" />
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource CardBorderHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Body" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Accent Primary Button Style -->
  <Style x:Key="AccentButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Body" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Danger / Delete Button Style -->
  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Background" Value="{StaticResource RoseBg}" />
    <Setter Property="Foreground" Value="{StaticResource Rose}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{StaticResource RoseBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="#4C1425" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Body" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern TextBox Style -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource CardBorderHover}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern ComboBox Style -->
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Modern CheckBox Style -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Modern Slider Style -->
  <Style TargetType="Slider">
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>

  <!-- Minimal ScrollBar Style -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Background="#354868" Margin="1,0" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DataGrid Modern Styles -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#17243C" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource CardBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Padding" Value="6,4" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource CardHoverBackground}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Modern ContextMenu & MenuItem -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource PanelBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

</ResourceDictionary>
