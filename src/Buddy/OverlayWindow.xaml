<Window x:Class="Buddy.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Buddy.Controls"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False" Height="420">
  <Canvas x:Name="Stage" Background="Transparent" ClipToBounds="True">
    <Ellipse x:Name="Shadow" Width="105" Height="14" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#50000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
    <Grid x:Name="AvatarHost" Width="147" Height="220" MouseLeftButtonDown="AvatarDown" MouseMove="AvatarMove" MouseLeftButtonUp="AvatarUp" Cursor="Hand" RenderTransformOrigin="0.5,1">
      <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="Facing" /><ScaleTransform x:Name="Breathing" /><TranslateTransform x:Name="Bob" /></TransformGroup></Grid.RenderTransform>
      <Rectangle x:Name="Placeholder" RadiusX="30" RadiusY="30" Fill="#405C91" Stroke="#FFCC5A" StrokeThickness="3" Margin="25,5,25,0" />
      <TextBlock x:Name="PlaceholderLabel" Text="Buddy" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <Image x:Name="AvatarImage" Stretch="Fill" />
    </Grid>
    <controls:SpeechBubble x:Name="Bubble" Visibility="Collapsed" />
  </Canvas>
</Window>
